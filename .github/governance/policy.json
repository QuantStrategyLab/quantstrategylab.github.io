{
  "version": "pr-governance/v3",
  "mode": "enforce",
  "review_routing": {
    "dispatch_mentions": [
      "@codex review",
      "@claude review"
    ]
  },
  "r0_paths": [
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs/prose/"
  ],
  "r2_paths": [
    "scripts/",
    ".github/governance/",
    ".github/scripts/",
    "site/**/*.js",
    "site/**/*.mjs",
    "site/**/*.cjs",
    "site/**/*.css",
    "site/**/*.png",
    "site/**/*.ico"
  ],
  "dependabot_template_exemption": true,
  "max_evidence_age_hours": 168
}
